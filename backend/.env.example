# Copy to backend/.env for local use. Configure hosted values in Render's
# environment settings; never commit populated .env files.
NODE_ENV=development
PORT=4000
# Local: 127.0.0.1. Render: 0.0.0.0 so the service accepts routed traffic.
HOST=127.0.0.1
# Exact frontend origin only (scheme + host, no path).
FRONTEND_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=meditrack_app
DB_PASSWORD=replace_with_a_local_database_password
DB_NAME=meditrack_db
# Production requires verified TLS. Use the provider CA text or a readable CA
# certificate file path; do not disable certificate verification.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CA_FILE=
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=8h
# Production: true. Use SameSite=none for cross-site hosting; Secure is required.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
DB_CONNECTION_LIMIT=10
AUTH_SESSION_CLEANUP_RETENTION_DAYS=30
AUTH_SESSION_CLEANUP_BATCH_SIZE=500
