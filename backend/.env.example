NODE_ENV=development
PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=meditrack_app
DB_PASSWORD=replace_with_a_local_database_password
DB_NAME=meditrack_db
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_SESSION_CLEANUP_RETENTION_DAYS=30
AUTH_SESSION_CLEANUP_BATCH_SIZE=500
